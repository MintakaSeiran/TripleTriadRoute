<Project>

  <!-- Fork releases are published from a verified local build.
       Keep the four-part Version in sync with the generated manifest and repo.json. -->

  <PropertyGroup Label="Identity">
    <Version>1.0.0.1</Version>
    <Authors>Triple Triad Route contributors</Authors>
    <Copyright>Copyright (c) XeldarAlz</Copyright>
    <PackageProjectUrl>https://github.com/MintakaSeiran/TripleTriadRoute</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MintakaSeiran/TripleTriadRoute</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Determinism" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
